{
  "name": "agent-superset",
  "version": "1.0.1",
  "description": "Portable production-quality engineering layer for coding agents",
  "type": "module",
  "bin": {
    "agent-superset": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.js tests/*/*.test.js",
    "check": "npm run test",
    "lint": "tsc -p tsconfig.json --noEmit",
    "build:local": "tsc --noCheck -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "workflows",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "playwright": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
